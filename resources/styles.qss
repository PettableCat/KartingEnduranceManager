/* =======================
   Base
   ======================= */
QMainWindow {
    background-color: #1e1e1e;
}

QLabel {
    color: #e0e0e0;
}

/* =======================
   Buttons
   ======================= */
QPushButton {
    background-color: #3a3a3a;
    color: #e6e6e6;
    border: 1px solid #4a4a4a;
    padding: 8px 18px;
    border-radius: 6px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #444444;
}

QPushButton:pressed {
    background-color: #2f2f2f;
}

QPushButton:disabled {
    background-color: #2a2a2a;
    color: #777777;
    border-color: #333333;
}

/* =======================
   GroupBox
   ======================= */
QGroupBox {
    border: 1px solid #3f3f3f;
    border-radius: 6px;
    margin-top: 16px;
    padding-top: 12px;
    color: #dcdcdc;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #cfcfcf;
}

/* =======================
   Inputs (excluding QSpinBox)
   ======================= */
QLineEdit, QComboBox {
    background-color: #262626;
    color: #e6e6e6;
    border: 1px solid #3a3a3a;
    border-radius: 5px;
    padding: 6px;
}

QLineEdit:focus,
QComboBox:focus {
    border: 1px solid #5a5a5a;
}

/* =======================
   Table
   ======================= */
QTableWidget {
    background-color: #232323;
    color: #e6e6e6;
    gridline-color: #2f2f2f;
    border: 1px solid #3a3a3a;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #3a3a3a;
    color: #e6e6e6;
}

/* =======================
   Header
   ======================= */
QHeaderView::section {
    background-color: #2a2a2a;
    color: #cfcfcf;
    padding: 6px;
    border: none;
    font-weight: 600;
}

/* =======================
   Tabs
   ======================= */
QTabWidget::pane {
    border: 1px solid #3a3a3a;
    background-color: #232323;
}

QTabBar::tab {
    background-color: #2a2a2a;
    color: #bfbfbf;
    padding: 8px 18px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #3a3a3a;
    color: #e6e6e6;
}

QTabBar::tab:hover {
    background-color: #333333;
}

/* =======================
   Scrollbar
   ======================= */
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3a3a3a;
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #444444;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
